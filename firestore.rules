rules_version='2'

service cloud.firestore {
  match /databases/{database}/documents {
    // User profile documents. A user may read and write only their own
    // document, and the document id must match their auth uid.
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.uid == userId;
      allow update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.uid == userId;
      allow delete: if request.auth != null && request.auth.uid == userId;

      // User -> Feedback posts subcollection (read/writable by the user)
      match /feedback_posts/{postId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create, update: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.authorId == userId
          && request.resource.data.author is string
          && request.resource.data.content is string
          && request.resource.data.content.size() > 0
          && request.resource.data.content.size() <= 4000;
        allow delete: if request.auth != null && request.auth.uid == userId;
      }

      // User -> Public posts subcollection (global readable, user writable/deletable)
      match /public_posts/{postId} {
        allow read: if true;
        allow create: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.authorId == userId
          && request.resource.data.author is string
          && request.resource.data.content is string
          && request.resource.data.content.size() > 0
          && request.resource.data.content.size() <= 2000;
        allow delete: if request.auth != null && request.auth.uid == userId;
      }
    }

    // CollectionGroup rule for global read access to `public_posts`
    match /{path=**}/public_posts/{postId} {
      allow read: if true;
    }

    // CollectionGroup rule for user-owned `feedback_posts`
    match /{path=**}/feedback_posts/{postId} {
      allow read: if request.auth != null && resource.data.authorId == request.auth.uid;
    }

    // Write-only waitlist signups captured directly from the landing page.
    // Individual documents are never enumerable from the client.
    match /waitlist/{entryId} {
      allow read: if false;
      allow create, update: if request.resource.data.email is string
        && request.resource.data.email.size() > 3
        && request.resource.data.email.size() <= 320;
      allow delete: if false;
    }

    // Create-only public waitlist chat messages (`waitlist_posts/{postId}`).
    // Readable by the public chat window, append-only (no update/delete).
    match /waitlist_posts/{postId} {
      allow read: if true;
      allow create: if request.resource.data.author is string
        && request.resource.data.author.size() >= 2
        && request.resource.data.author.size() <= 50
        && request.resource.data.email is string
        && request.resource.data.email.size() > 3
        && request.resource.data.email.size() <= 320
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 2000;
      allow update, delete: if false;
    }

    // Strictly write-only private waitlist product feedback (`waitlist_feedback/{postId}`).
    match /waitlist_feedback/{postId} {
      allow read: if false;
      allow create: if request.resource.data.author is string
        && request.resource.data.author.size() >= 2
        && request.resource.data.author.size() <= 50
        && request.resource.data.email is string
        && request.resource.data.email.size() > 3
        && request.resource.data.email.size() <= 320
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 4000;
      allow update, delete: if false;
    }

    // Sparse collection of active ElectionSets (`electionSets/{setId}`) with
    // waitlist user counters.
    match /electionSets/{setId} {
      allow read: if true;
      allow create, update: if request.resource.data.id == setId
        && request.resource.data.name is string
        && request.resource.data.tier in ['municipal', 'provincial', 'federal']
        && request.resource.data.count is int
        && request.resource.data.count >= 0;
      allow delete: if false;

      // Per-district user membership records (`electionSets/{setId}/members/{userId}`)
      match /members/{userId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.uid == userId;
        allow update, delete: if false;
      }
    }

    // Legacy public read-only aggregate counts per community.
    match /waitlistCounts/{communityId} {
      allow read: if true;
      allow write: if false;
    }

    // Public read-only platform metadata (e.g., `public_metadata/stats` user_count).
    match /public_metadata/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Public constituent messages to representatives (`comms_public/{msgId}`).
    // Written exclusively by the `submitConstituentMessage` Cloud Function.
    match /comms_public/{msgId} {
      allow read: if true;
      allow write: if false;
    }

    // Private constituent messages (`comms_private/{msgId}`).
    // Strictly server-managed via Cloud Functions.
    match /comms_private/{msgId} {
      allow read, write: if false;
    }

    // Representative unsubscribe blocklist (`rep_email_blocklist/{repId}`).
    // Readable by the client to warn users when a representative has opted out;
    // writable only by the HMAC-verified `unsubscribeRepresentative` Cloud Function.
    match /rep_email_blocklist/{repId} {
      allow read: if true;
      allow write: if false;
    }

    match /{document=**} {
      // Deny by default. Every collection must have an explicit rule above.
      allow read, write: if false;
    }
  }
}
